# Database Configuration (NeonDB)
# Get these from your Neon Console: https://console.neon.tech/
host=your-neon-hostname.neon.tech
user=your-username  
database=your-database-name
password=your-password
port=5432

# Optional: Square API (if needed)
SQUARE_LOCATION_ID=your-square-location-id

# Server Configuration
EXPRESS_PORT=8001
NODE_ENV=development

# To use the old hardcoded production database instead, set:
# PORT=8001
# (This forces production mode and uses hardcoded credentials)
