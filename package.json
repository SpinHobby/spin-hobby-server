  "type": "module",
  "scripts": {
    "reset": "npx sequelize-cli db:drop; sudo -u postgres createdb spinhobby; npx sequelize-cli db:migrate",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "migrate": "node db/migrate.cjs migrate",
    "migrate:reset": "node db/migrate.cjs reset",
    "migrate:status": "node db/migrate.cjs status",
    "db:setup": "npm run migrate:reset && npm run seed",
    "db:reset": "npm run migrate:reset && npm run seed",
    "db:full-reset": "npm run migrate:reset && npm run seed:force",
    "db:test": "node db/test-connection.cjs",
    "seed": "node db/seed.cjs",
    "seed:status": "node db/seed.cjs status",
    "seed:force": "node db/seed.cjs force",
    "seed:clear": "node db/seed.cjs clear"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.44",
