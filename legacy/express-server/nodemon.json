{
  "watch": ["src/**/*"],
  "ext": "ts,js,json",
  "ignore": [
    "node_modules/**/*",
    "dist/**/*",
    "build/**/*",
    "*.log",
    "db/migrations/*.sql",
    "db/seeds/*.sql",
    ".git/**/*",
    "*.test.ts",
    "*.spec.ts"
  ],
  "exec": "npx tsx src/index.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true
}
