# ---------------------------------------------------------------------------
# Spin Hobby API (NestJS) - copy to .env for local runs, set as host variables in production
# (Render: the service's Environment tab). This server is the only backend; there are no edge functions.
# ---------------------------------------------------------------------------

# Server
PORT=8080
# Optional path prefix, e.g. "api" -> https://host/api/products
API_PREFIX=
# Browser origins allowed in addition to https://spinhobby.com and https://www.spinhobby.com
ALLOWED_ORIGINS=https://admin.spinhobby.com,http://localhost:5173
STOREFRONT_URL=https://spinhobby.com

# Database: the Supabase Postgres connection string (Project Settings > Database > Connection string).
# Use the pooler URI in production. DATABASE_SSL=false only for a local Postgres.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# Supabase Auth: tokens from the storefront are verified against the project's signing keys.
SUPABASE_URL=https://<project-ref>.supabase.co
# Used server-side to sign people in through Supabase Auth (the browser never sees Supabase).
SUPABASE_PUBLISHABLE_KEY=
# Server-only: lets the API write admin photo uploads to the product-images storage bucket.
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still uses the legacy shared JWT secret instead of signing keys:
SUPABASE_JWT_SECRET=
# Accounts promoted automatically on sign-in (comma separated)
OWNER_EMAILS=
STAFF_EMAILS=
# Staging only (APP_ENV=staging): a fixed owner login typed as username + password on the sign-in
# form. Ignored in production. See STAGING.md.
STAGING_ADMIN_USERNAME=
STAGING_ADMIN_PASSWORD=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Square
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match the notification URL configured in Square, e.g. https://api.spinhobby.com/webhooks/square
SQUARE_WEBHOOK_URL=
# Lets a cron job call POST /square-sync with the x-square-sync-secret header
SQUARE_SYNC_TRIGGER_SECRET=
# Run the catalog sync automatically every N minutes (0 = off)
SQUARE_SYNC_INTERVAL_MINUTES=0
# Category that marks cashier-created convention one-offs as hidden from the storefront
SQUARE_CASHIER_CATEGORY_ID=

# Email (Resend) - order confirmations, "your order shipped" and restock emails.
# FROM_EMAIL must be on a domain verified in Resend. Without both, no email is sent.
RESEND_API_KEY=
FROM_EMAIL=

# Stock holds: an unpaid checkout keeps its items out of other shoppers' reach for this many minutes,
# and abandoned ones are cancelled every ORDER_EXPIRY_INTERVAL_MINUTES (0 = never run the cleanup).
ORDER_HOLD_MINUTES=30
ORDER_EXPIRY_INTERVAL_MINUTES=10
# A catalog sync that would hide more than this share of the Square products is skipped (looks like a partial read)
SQUARE_SYNC_RETIRE_MAX_RATIO=0.5

# Abuse protection and diagnostics
# Requests per minute per IP across the API (sensitive routes have tighter built-in limits); THROTTLE_DISABLED=true turns limits off
RATE_LIMIT_PER_MINUTE=300
THROTTLE_DISABLED=false
# Proxies in front of the server whose X-Forwarded-For we trust (Render = 2: Cloudflare + its proxy). Rate limits key on the resulting client IP.
TRUST_PROXY_HOPS=2
# One access-log line per request (set false to silence)
LOG_REQUESTS=true
# Error tracking: set after creating a Sentry project AND running `npm i @sentry/node`
SENTRY_DSN=

# Cashier photo identification (Claude)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Browser build (spin-hobby repo, Netlify): the only setting it needs.
# ---------------------------------------------------------------------------
VITE_API_URL=https://<your-api-host>
