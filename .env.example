# ---------------------------------------------------------------------------
# Spin Hobby API (NestJS). Copy to .env for local runs; in production set these as host variables
# (Render: the service's Environment tab). Every setting is optional unless it says "required";
# a missing integration is reported by GET /health, never a crash.
#
# `npm run dev:local` needs none of this: it starts its own database and fakes sign-in.
# The settings are read in src/config/*.config.ts: look there for each one's default.
# ---------------------------------------------------------------------------

# ---- Environment ----------------------------------------------------------------------------------
# production on the live site. Anything else is "local development" (sample images, API docs at /docs, dev login allowed).
NODE_ENV=development
# staging on the staging deployment (shared staging admin login, sample data, API docs). Leave empty in production.
APP_ENV=
# Port to listen on (Render sets it).
PORT=8080
# Optional path prefix for every route, e.g. "api" -> https://host/api/products
API_PREFIX=
# Where this API is reachable from outside; used to build links to uploaded files.
PUBLIC_API_URL=
# The storefront's address, used for links in emails.
STOREFRONT_URL=https://spinhobby.com
# Browser origins allowed in addition to https://spinhobby.com and www (comma separated; one "*" matches a subdomain label).
ALLOWED_ORIGINS=https://admin.spinhobby.com,http://localhost:5173

# ---- Database (required) --------------------------------------------------------------------------
# The Supabase Postgres connection string (Project Settings > Database > Connection string). Use the pooler URI in production.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# TLS to Postgres. Set false only for a local Postgres.
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
# How long to wait for a free connection, in milliseconds.
DATABASE_CONNECT_TIMEOUT_MS=10000
# Apply pending migrations from supabase/migrations when the server starts. Set false to skip.
MIGRATE_ON_START=true
# Where the migration files are (default: ./supabase/migrations).
MIGRATIONS_DIR=

# ---- Sign-in: Supabase Auth -----------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Used server-side to sign people in through Supabase Auth (the browser never talks to Supabase). Older projects: SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Server-only: lets the API write admin photo uploads to the product-images storage bucket. Newer projects: SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still uses the legacy shared JWT secret instead of signing keys.
SUPABASE_JWT_SECRET=
# Accounts promoted automatically on sign-in (comma separated emails).
OWNER_EMAILS=
STAFF_EMAILS=
# Staging only (APP_ENV=staging): a fixed owner login typed as username + password on the sign-in form. See STAGING.md.
STAGING_ADMIN_USERNAME=
STAGING_ADMIN_PASSWORD=
# Local development only: your own Supabase or Neon project for `npm run dev:local` instead of its in-memory database
# (data kept between runs; see docs/INTERNS.md, "Your own database"). The shop's databases are refused.
DEV_DATABASE_URL=
# Local development only (never works in production): sign in without Supabase. `npm run dev:local` turns this on.
AUTH_DEV_LOGIN=false
AUTH_DEV_PASSWORD=
# Emails allowed to use the dev login (comma separated, optionally email:role).
AUTH_DEV_USERS=
# Local development only: where uploaded photos are written when there is no Supabase Storage.
LOCAL_UPLOAD_DIR=

# ---- Square: catalog, stock and card payments -----------------------------------------------------
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# sandbox or production. (SQUARE_ENV is the older name for the same setting.)
SQUARE_ENVIRONMENT=sandbox
# Pin the Square API version for REST calls; empty uses the account's default.
SQUARE_API_VERSION=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match the notification URL configured in Square, e.g. https://api.spinhobby.com/webhooks/square
SQUARE_WEBHOOK_URL=
# Lets a cron job call POST /square-sync with the x-square-sync-secret header.
SQUARE_SYNC_TRIGGER_SECRET=
# Run the catalog sync automatically every N minutes (0 = only when asked).
SQUARE_SYNC_INTERVAL_MINUTES=0
# A sync that would hide more than this share of the products is skipped (it looks like a partial read from Square).
SQUARE_SYNC_RETIRE_MAX_RATIO=0.5
# The Square category that marks cashier one-offs "not for the website". Empty uses the live Spin Hobby
# category id (see CASHIER_CATEGORY_ID in src/config/square.config.ts). Only set it for a different Square account.
SQUARE_CASHIER_CATEGORY_ID=

# ---- eBay: list products on eBay, stock kept in step with Square --------------------------------------
# The shop's eBay developer app (developer.ebay.com -> Application keys) and its RuName (User Tokens -> "Get a Token from eBay via
# Your Application": the name of the sign-in return address, which must point at this server's /ebay/oauth/callback).
# An owner then connects the seller account in the admin (Settings -> eBay), signing in on eBay's own page.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
# sandbox or production.
EBAY_ENVIRONMENT=sandbox
# The eBay site and currency listings use (EBAY_CA / CAD for eBay Canada).
EBAY_MARKETPLACE_ID=EBAY_CA
EBAY_CURRENCY=CAD
# Encrypts the seller's eBay tokens in the database. Required to connect: openssl rand -base64 32
EBAY_TOKEN_KEY=
# Where to send the owner back after signing in on eBay (default STOREFRONT_URL/admin).
EBAY_ADMIN_RETURN_URL=
# Marketplace account deletion notices (eBay requires this endpoint before production keys work): the verification token you type in the
# eBay developer portal (32-80 letters, digits, _ or -) and the exact endpoint, e.g. https://api.spinhobby.com/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=
# Check eBay orders every N minutes, so an eBay sale takes the unit off Square (0 = only when asked).
EBAY_SYNC_INTERVAL_MINUTES=2
# Compare every eBay listing's quantity with Square's and correct it every N minutes (0 = off).
EBAY_RECONCILE_INTERVAL_MINUTES=30

# ---- PayPal ---------------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live (live moves real money).
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# ---- Audit documents (Google Drive) -----------------------------------------------------------------
# Admin > Audit shows the PDFs (and other files) in one Google Drive folder. Make a service account in Google Cloud (enable the
# Google Drive API, create a JSON key), share the folder with the service account's email as Viewer, then paste the whole
# JSON key on one line and the folder's id (the last part of its address: drive.google.com/drive/folders/<id>).
# Without both, Audit still shows sales records; the Documents tab says Drive isn't connected.
GOOGLE_SERVICE_ACCOUNT_JSON=
AUDIT_DRIVE_FOLDER_ID=

# ---- Email (Resend) -------------------------------------------------------------------------------
# Order confirmations, "your order shipped" and restock emails. FROM_EMAIL must be on a domain verified in Resend.
# Without both, no email is sent.
RESEND_API_KEY=
FROM_EMAIL=

# ---- Orders ---------------------------------------------------------------------------------------
# An unpaid checkout keeps its items out of other shoppers' reach for this many minutes...
ORDER_HOLD_MINUTES=30
# ...and abandoned ones are cancelled by a job that runs this often (minutes; 0 = never).
ORDER_EXPIRY_INTERVAL_MINUTES=10

# ---- Abuse protection and diagnostics -------------------------------------------------------------
# Requests per minute per IP across the API (sensitive routes have tighter built-in limits).
RATE_LIMIT_PER_MINUTE=300
# true turns every rate limit off (load tests only).
THROTTLE_DISABLED=false
# Proxies in front of the server whose X-Forwarded-For we trust. Default: 3 on Render, 1 elsewhere.
# TRUST_PROXY_HOPS=
# One access-log line per request. Set false to silence.
LOG_REQUESTS=true
# Error tracking: set after creating a Sentry project and running `npm i @sentry/node`.
SENTRY_DSN=

# ---- Cashier photo identification (Claude) --------------------------------------------------------
ANTHROPIC_API_KEY=
# Alternative to the API key for gateways that use a bearer token.
ANTHROPIC_AUTH_TOKEN=

# ---- Sample data (staging and local) --------------------------------------------------------------
# On staging an empty database is filled with sample products on start. Set false to turn that off.
SAMPLE_DATA=
# Set only by `npm run dev:local`: with no payment keys, checkout completes with a test payment (no money). Ignored in production,
# on staging and on Render. Never set it anywhere else.
DEV_TEST_PAYMENTS=
# Where sample pictures are served from (default: Render's public URL, or http://localhost:PORT).
SAMPLE_IMAGE_BASE=

# ---- Set by the host (Render). You never set these ------------------------------------------------
# RENDER, RENDER_EXTERNAL_URL, RENDER_GIT_COMMIT

# ---------------------------------------------------------------------------
# Browser build (spin-hobby repo, Netlify): the only setting it needs.
# ---------------------------------------------------------------------------
VITE_API_URL=https://<your-api-host>

# The talking shop assistant on the storefront (answered by the shop's Gleamshelf computer, or a text answer while it is away): on or off.
# Default: on everywhere but the live site (staging is on, although it runs as NODE_ENV=production).
SHOP_ASSISTANT=
